# Where Ollama is running and which model to use.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional tuning for low-end laptops. Leave unset to let Ollama decide.
# Set OLLAMA_NUM_GPU=0 when a small GPU (for example 2 GB) can only hold a few
# layers; pure CPU is then faster and the model loads much quicker.
# OLLAMA_NUM_GPU=0
# Number of CPU threads; usually best left unset (Ollama uses physical cores).
# OLLAMA_NUM_THREAD=4
